! Representative CP2K reference input for the mlip_evidence tooling demo.
! This is a SAMPLE that mirrors the methods-level protocol parameters (functional,
! dispersion, grid cutoffs, metallic-SCF strategy). It is not a campaign data file and
! contains no results. Cell/coords are placeholders.
&GLOBAL
  PROJECT sample
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    CHARGE 0
    &POISSON
      PERIODIC XYZ
      PSOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
      NGRIDS 4
    &END MGRID
    &SCF
      EPS_SCF 1.0E-6
      MAX_SCF 400
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      ADDED_MOS 120
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
          R_CUTOFF 12.0
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
      PERIODIC XYZ
    &END CELL
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
